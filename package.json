{
  "name": "ai-assitant-node",
  "version": "1.0.0",
  "description": "Discord gateway bot + CLI for Jira task automation, plus a web chat app on Amplify",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "bot/client.js",
  "scripts": {
    "start": "nodemon --ignore context/ bot/client.js",
    "bot": "node bot/client.js",
    "cli": "node cli.js",
    "register-commands": "node scripts/register-commands.js",
    "groq:billing": "node scripts/check-groq-billing.js",
    "jira:activity": "node scripts/jira-monthly-activity.js",
    "github:activity": "node scripts/github-monthly-activity.js",
    "extension:pack": "node scripts/pack-firefox-extension.js",
    "test:github-list-repos": "node scripts/test-github-list-repos.js",
    "test:agent-runtime": "tsx scripts/test-agent-runtime.ts",
    "test:integrations": "node scripts/test-integrations-live.js",
    "test": "npm run test:github-list-repos",
    "dev": "vite",
    "build": "tsc -b && NODE_ENV=production vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "amplify:sandbox": "npx ampx sandbox",
    "amplify:secret:groq": "npx ampx sandbox secret set GROQ_API_KEY",
    "amplify:secret:google": "npx ampx sandbox secret set GOOGLE_AI_STUDIO_API_KEY",
    "amplify:secret:openrouter": "npx ampx sandbox secret set OPENROUTER_API_KEY",
    "amplify:secret:jira": "npx ampx sandbox secret set JIRA_API_TOKEN",
    "amplify:secret:github": "npx ampx sandbox secret set GITHUB_TOKEN",
    "amplify:secret:serp": "npx ampx sandbox secret set SERP_API_KEY",
    "amplify:secret:firebase": "npx ampx sandbox secret set FIREBASE_SDK_SA_KEY",
    "amplify:secret:supabase": "npx ampx sandbox secret set SUPABASE_SECRET_KEY_CURTIS",

    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^15.0.0",
    "cron-parser": "^5.6.2",
    "discord.js": "^14.26.5",
    "dotenv": "^16.4.7",
    "groq-sdk": "^1.3.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "next-themes": "^0.4.6",
    "nodemon": "^3.1.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.21.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.25.1",
    "@aws-amplify/backend-cli": "^1.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "aws-cdk-lib": "^2.272.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  }
}
