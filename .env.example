# --- Web app (Vite + Amplify) ---------------------------------------------
# Supabase project origin and publishable key. Read by Vite and baked into the
# chat Lambda's environment by amplify/loadEnv.ts at synth time. Suffixed so a
# shell-wide VITE_SUPABASE_URL for another project can't take precedence.
VITE_SUPABASE_URL_CURTIS=
VITE_SUPABASE_PUBLISHABLE_KEY_CURTIS=

# Comma-separated emails allowed to use the chat Lambda (it acts with your
# Jira/GitHub credentials). Empty = nobody.
ALLOWED_EMAILS=

# Non-secret integration settings copied into the Lambda environment.
JIRA_BASE_URL=
JIRA_EMAIL=
SERP_PROVIDER=
GROQ_MODEL=
GROQ_FALLBACK_MODEL=
REQUIRE_CONFIRMATION=
GITHUB_ACTIVITY_LOGINS=
GITHUB_ACTIVITY_ALIASES=
GITHUB_ACTIVITY_EXCLUDE_OWNERS=

# Lambda secrets live in the Amplify sandbox, not here:
#   npm run amplify:secret:groq    -> GROQ_API_KEY
#   npm run amplify:secret:google  -> GOOGLE_AI_STUDIO_API_KEY
#   npm run amplify:secret:openrouter -> OPENROUTER_API_KEY
#   npm run amplify:secret:jira    -> JIRA_API_TOKEN
#   npm run amplify:secret:github  -> GITHUB_TOKEN
#   npm run amplify:secret:serp    -> SERP_API_KEY

# --- Local Discord bot + CLI (npm start) ----------------------------------
JIRA_API_TOKEN=
GITHUB_TOKEN=
GROQ_API_KEY=
GOOGLE_AI_STUDIO_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
SERP_API_KEY=
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_APP_ID=
DISCORD_CLIENT_SECRET=
PUBLIC_BASE_URL=
