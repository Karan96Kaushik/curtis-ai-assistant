{
  "manifest_version": 3,
  "name": "Curtis Bridge",
  "version": "1.0.9",
  "description": "Lets Curtis (local Discord AI) drive this Firefox session over a localhost WebSocket (ws://, not wss). Debug logs: [CurtisBridge]",
  "browser_specific_settings": {
    "gecko": {
      "id": "curtis-bridge@localhost",
      "strict_min_version": "109.0"
    }
  },
  "permissions": ["tabs", "scripting", "storage", "windows"],
  "host_permissions": [
    "<all_urls>",
    "ws://127.0.0.1/*",
    "ws://localhost/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:* ws://localhost:* http://127.0.0.1:* http://localhost:*"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Curtis Bridge",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://teams.microsoft.com/*", "https://*.teams.microsoft.com/*", "https://outlook.office.com/*", "https://teams.cloud.microsoft/*"],
      "js": ["content/teams.js"],
      "run_at": "document_idle"
    }
  ]
}
